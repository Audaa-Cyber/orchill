{
  "name": "orchill",
  "version": "0.1.0",
  "description": "A selective, safety-conscious CLI for discovering and installing AI agent skills.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "orchill": "./dist/cli.js"
  },
  "files": [
    "dist",
    "registry",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "journal.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test tests/safety.test.ts tests/install.test.ts tests/registry.test.ts tests/bulk-import.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
