{
  "name": "orchill",
  "version": "0.1.0",
  "description": "A selective, safety-conscious CLI for discovering and installing AI agent skills.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "orchill": "./dist/cli.js"
  },
  "files": [
    "dist",
    "registry",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "journal.md",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test tests/audit.test.ts tests/safety.test.ts tests/install.test.ts tests/registry.test.ts tests/bulk-import.test.ts tests/marketplace-import.test.ts tests/release-readiness.test.ts tests/provenance.test.ts tests/release-review-queue.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "catalog:generate": "tsx scripts/generate-catalog.ts",
    "release:check": "tsx scripts/check-release-readiness.ts",
    "prepublishOnly": "npm run build && npm run release:check -- --strict",
    "provenance:inventory": "tsx scripts/build-provenance-inventory.ts",
    "release:review-queue": "tsx scripts/build-release-review-queue.ts",
    "package:smoke": "tsx scripts/smoke-packed-package.ts"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Audaa-Cyber/orchill.git"
  },
  "homepage": "https://github.com/Audaa-Cyber/orchill#readme",
  "bugs": {
    "url": "https://github.com/Audaa-Cyber/orchill/issues"
  }
}
